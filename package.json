{
  "name": "zvault",
  "version": "1.0.0",
  "description": "A Double Encrypted Secure Personal Vault",
  "main": "dist/main/main.js",
  "scripts": {
    "build:main": "tsc -b tsconfig.json",
    "build:renderer": "cd src/renderer/zvault && npm run build",
    "build": "npm run build:main && npm run build:renderer",
    "dev:main": "tsc --watch -p tsconfig.json",
    "dev:renderer": "cd src/renderer/zvault && npm run start",
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\" \"electronmon . --watch dist/main\"",
    "start": "electron .",
    "dist": "npm run build && electron-builder --publish never",
    "release": "npm run build && electron-builder --publish always",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.sujoygiri.ZVault",
    "productName": "ZVault",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/renderer/zvault/dist",
        "to": "renderer/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "sujoygiri",
        "repo": "ZVault",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "build/vault-icon.png",
      "target": "nsis"
    },
    "mac": {
      "icon": "build/vault-icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "build/vault-icon.png",
      "target": "AppImage"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@duckdb/node-api": "^1.4.3-r.2",
    "@node-rs/argon2": "^2.0.2",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11",
    "googleapis": "^180.0.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.0.3",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "electronmon": "^2.0.4",
    "nodemon": "^3.1.11",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "tsc-watch": "^7.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  }
}