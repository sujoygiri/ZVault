{
  "name": "zvault",
  "version": "1.0.0",
  "description": "Your secure vault app built with Electron",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "concurrently \"tsc --watch\" \"electronmon . --watch dist\"",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.example.ZVault",
    "productName": "ZVault",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/renderer/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "src/renderer/",
        "to": "renderer/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@duckdb/node-api": "^1.4.3-r.2",
    "@googleapis/drive": "^20.0.1",
    "@node-rs/argon2": "^2.0.2",
    "google-auth-library": "^10.5.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "electronmon": "^2.0.4",
    "nodemon": "^3.1.11",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "tsc-watch": "^7.2.0",
    "typescript": "^5.9.3"
  }
}
